# ── Backend ──────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/african_fashion_db
# DATABASE_CA_CERT: PEM-encoded CA certificate for SSL verification in production.
# Required when connecting to managed databases (Railway, AWS RDS, etc.) that use
# a private CA. Leave unset in development; in production, SSL verification is
# always enforced (rejectUnauthorized: true). Example: copy the contents of the
# CA .pem file as a single-line string (replace newlines with \n).
# DATABASE_CA_CERT=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=african_fashion_db
AUTO_SYNC=true

# JWT secrets: JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST be set to different values in production.
# If only JWT_SECRET is set, both access and refresh tokens will share the same key (insecure).
JWT_ACCESS_SECRET=your-access-secret-change-this-to-a-unique-value
JWT_REFRESH_SECRET=your-refresh-secret-change-this-to-a-different-unique-value

# Frontend URL (used for CORS, email verification links, password reset links)
FRONTEND_URL=http://localhost:3000

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="African Fashion Marketplace <noreply@africanfashion.com>"

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Payment defaults
PAYMENT_DEFAULT_CURRENCY=NGN
PAYMENT_CALLBACK_URL=http://localhost:3000/payments/callback

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# One-time OAuth exchange code TTL in seconds (max 600)
GOOGLE_AUTH_CODE_TTL_SECONDS=120

# Loyalty Points
LOYALTY_POINTS_PER_DOLLAR=1
LOYALTY_POINTS_REDEMPTION_RATE=100
ABANDONED_CART_THRESHOLD_HOURS=1

# ── Frontend (prefix with NEXT_PUBLIC_ for client-side access) ──
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
