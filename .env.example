# =============================================================
# African Fashion eCommerce - Backend Environment Variables
# =============================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control
# =============================================================

# ---- Server Configuration ----
# The environment the app is running in
NODE_ENV=development

# Port the server listens on (Railway sets this automatically)
PORT=3000

# ---- Database ----
# PostgreSQL connection string
# Railway format: postgresql://user:password@host:port/database
# Local format:   postgresql://postgres:postgres@localhost:5432/african_fashion
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/african_fashion

# ---- JWT Authentication ----
# Generate a strong secret: openssl rand -base64 64
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

# ---- Google OAuth (optional) ----
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Railway production callback URL:
GOOGLE_CALLBACK_URL=https://your-api.railway.app/auth/google/callback

# ---- Frontend Configuration ----
# URL of the deployed Next.js frontend (used for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3001

# ---- Railway-Specific Notes ----
# When deploying to Railway:
# 1. Add a PostgreSQL plugin - Railway auto-provisions DATABASE_URL
# 2. Set NODE_ENV=production
# 3. Set strong JWT secrets (never use defaults in production)
# 4. Update GOOGLE_CALLBACK_URL with your Railway API URL
# 5. Update FRONTEND_URL with your deployed frontend URL

