{
  "info": {
    "name": "African Fashion API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"John Doe\",\n  \"country\": \"Nigeria\",\n  \"role\": \"CUSTOMER\"\n}"
        }
      },
      "event": [{"listen": "test", "script": {"exec": ["const res = pm.response.json();", "pm.collectionVariables.set('userId', res.id);"]}}]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
        }
      },
      "event": [{"listen": "test", "script": {"exec": ["const res = pm.response.json();", "pm.collectionVariables.set('accessToken', res.accessToken);", "pm.collectionVariables.set('refreshToken', res.refreshToken);", "pm.collectionVariables.set('userId', res.user.id);"]}}]
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      },
      "event": [{"listen": "test", "script": {"exec": ["const res = pm.response.json();", "pm.collectionVariables.set('accessToken', res.accessToken);", "pm.collectionVariables.set('refreshToken', res.refreshToken);"]}}]
    },
    {
      "name": "Get User",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}",
        "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}]
      }
    },
    {
      "name": "Update User",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/users/{{userId}}",
        "header": [
          {"key": "Authorization", "value": "Bearer {{accessToken}}"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"country\": \"Ghana\"\n}"
        }
      }
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    }
  ]
}
