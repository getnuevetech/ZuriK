# Copy to /etc/zurik/web.env
# These NEXT_PUBLIC_ values are baked into the frontend at build time.
# Change them here, then run the build script again. Restarting the
# web service alone does not pick them up.

NODE_ENV=production
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_URL=https://example.com
